# Sailfish OS
RPMS/

# Cross-compiled native dependencies, built by CI inside the SDK container and
# cached there on the hash of their build script.
3rdparty/

# Tesseract language data: downloaded by scripts/download_models_for_build.sh,
# pinned by SHA256, and bundled into the RPM. 27MB of binaries have no business
# in a git history - the app ships them, the repo does not carry them.
tessdata/

# Photographs and documents to measure the recognition pipeline against, dropped
# in by hand. The same rule as the language data: they are tens of megabytes of
# camera JPEGs and scanned paperwork, the history is not the place for them, and
# the PDFs in particular are somebody's actual documents.
# tests/fixtures/portrait_exif.jpg is the exception and is committed - it is
# 1.8KB and it exists to pin one EXIF tag.
tests/fixtures/IMG_*.jpg
tests/fixtures/*.pdf

